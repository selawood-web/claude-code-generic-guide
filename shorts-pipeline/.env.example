# Copy to .env (never committed). Only the providers named in config.yaml need keys.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
PEXELS_API_KEY=

# YouTube Data API v3 (OAuth 2.0, offline access -> refresh token)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok Content Posting API (video.publish scope; unaudited apps post private-only)
TIKTOK_ACCESS_TOKEN=

# Public base URL of this service (Instagram fetches the video from here)
SHORTS_PUBLIC_BASE_URL=
