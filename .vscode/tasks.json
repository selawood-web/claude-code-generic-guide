{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Demo Walkthrough",
      "type": "shell",
      "command": "code demo/WALKTHROUGH.md",
      "inAgents": true,
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Open README",
      "type": "shell",
      "command": "code README.md",
      "inAgents": true,
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Recent commits",
      "type": "shell",
      "command": "git --no-pager log --oneline -15",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "List skills",
      "type": "shell",
      "command": "Get-ChildItem .claude/skills -Directory | Select-Object -ExpandProperty Name",
      "inAgents": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
